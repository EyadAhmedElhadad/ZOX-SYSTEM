{
  "id": "/",
  "name": "Zoox — Gaming Center Management System",
  "short_name": "Zoox",
  "description": "Manage rooms, sessions, reservations, and café sales from one fast operational dashboard.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0a0a12",
  "theme_color": "#7c3aed",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "games"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Live Sessions",
      "short_name": "Sessions",
      "description": "Open live game sessions",
      "url": "/live-sessions",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Reservations",
      "short_name": "Bookings",
      "description": "Manage reservations and bookings",
      "url": "/reservations",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Customer Feedback",
      "short_name": "Feedback",
      "description": "Review customer feedback",
      "url": "/feedback",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
